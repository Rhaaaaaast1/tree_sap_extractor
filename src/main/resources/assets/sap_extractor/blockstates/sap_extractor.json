{
  "multipart": [
    {
      "when": { "facing": "north", "open": "false" },
      "apply": { "model": "sap_extractor:block/sap_extractor", "y": 0 }
    },
    {
      "when": { "facing": "north", "open": "true" },
      "apply": { "model": "sap_extractor:block/sap_extractor_open", "y": 0 }
    },
    {
      "when": { "facing": "east", "open": "false" },
      "apply": { "model": "sap_extractor:block/sap_extractor", "y": 90 }
    },
    {
      "when": { "facing": "east", "open": "true" },
      "apply": { "model": "sap_extractor:block/sap_extractor_open", "y": 90 }
    },
    {
      "when": { "facing": "south", "open": "false" },
      "apply": { "model": "sap_extractor:block/sap_extractor", "y": 180 }
    },
    {
      "when": { "facing": "south", "open": "true" },
      "apply": { "model": "sap_extractor:block/sap_extractor_open", "y": 180 }
    },
    {
      "when": { "facing": "west", "open": "false" },
      "apply": { "model": "sap_extractor:block/sap_extractor", "y": 270 }
    },
    {
      "when": { "facing": "west", "open": "true" },
      "apply": { "model": "sap_extractor:block/sap_extractor_open", "y": 270 }
    }
  ]
}
